-- =========================================================
-- [ SYSTEM CLEANUP ]
-- =========================================================
if _G.SnyX_Connection then 
    _G.SnyX_Connection:Disconnect() 
    _G.SnyX_Connection = nil
end
_G.SnyX_AutoCollect = false

local oldUI = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("SnyX_ESP_GUI")
if oldUI then oldUI:Destroy() end

local HIGHLIGHT_NAME = "SnyX_ItemHighlight"

local function cleanHighlights()
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == HIGHLIGHT_NAME then
            desc:Destroy()
        end
    end
end
cleanHighlights()

-- =========================================================
-- [ CONFIG & LOGIC ]
-- =========================================================
local ESPEnabled = false
local FILL_COLOR = Color3.fromRGB(255, 0, 0)
local OUTLINE_COLOR = Color3.fromRGB(255, 255, 255)

-- ตรวจสอบว่าเป็นไอเทมในเกม (และข้ามตัวละครผู้เล่นเอง)
local function isTargetItem(object)
    if not object or not object.Parent then return false end
    if LocalPlayer.Character and object:IsDescendantOf(LocalPlayer.Character) then return false end
    
    if object:IsA("Tool") or object:IsA("TouchTransmitter") or object:IsA("ProximityPrompt") then
        return true
    end
    return false
end

-- แสดงผล ESP
local function applyESP(object)
    if not ESPEnabled then return end
    local target = object:IsA("Tool") and object or object.Parent
    if target and target:IsA("PVInstance") and not target:FindFirstChild(HIGHLIGHT_NAME) then
        if LocalPlayer.Character and target:IsDescendantOf(LocalPlayer.Character) then return end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = HIGHLIGHT_NAME
        highlight.FillColor = FILL_COLOR
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = OUTLINE_COLOR
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = target
    end
end

local function toggleESP(state)
    ESPEnabled = state
    if not state then
        cleanHighlights()
    end
end

-- ระบบ Auto Collect รองรับทั้ง Touch และ ProximityPrompt
local function collectItem(desc)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if desc:IsA("TouchTransmitter") and desc.Parent then
        local targetPart = desc.Parent
        if firetouchinterest then
            firetouchinterest(root, targetPart, 0)
            task.wait(0.01)
            firetouchinterest(root, targetPart, 1)
        else
            targetPart.CFrame = root.CFrame
        end
    elseif desc:IsA("ProximityPrompt") then
        if fireproximityprompt then
            fireproximityprompt(desc)
        end
    elseif desc:IsA("Tool") and desc:FindFirstChild("Handle") then
        local handle = desc.Handle
        local transmitter = handle:FindFirstChildOfClass("TouchTransmitter")
        if firetouchinterest and transmitter then
            firetouchinterest(root, handle, 0)
            task.wait(0.01)
            firetouchinterest(root, handle, 1)
        else
            handle.CFrame = root.CFrame
        end
    end
end

-- ลูปสแกนหลักแบบเจาะลึกทุกระดับชั้น (GetDescendants)
task.spawn(function()
    while true do
        task.wait(0.5)
        if ESPEnabled or _G.SnyX_AutoCollect then
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if isTargetItem(desc) then
                    if ESPEnabled then
                        applyESP(desc)
                    end
                    if _G.SnyX_AutoCollect then
                        collectItem(desc)
                    end
                end
            end
        end
    end
end)

