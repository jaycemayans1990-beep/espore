local HIGHLIGHT_NAME = "SnyX_ItemHighlight"

local function cleanHighlights()
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == HIGHLIGHT_NAME then
            desc:Destroy()
        end
    end
end
cleanHighlights()

-- =========================================================
-- [ CONFIG & LOGIC ]
-- =========================================================
local ESPEnabled = false
local UseMagnetMode = true -- เปิดโหมดวาร์ปแตะไอเทมระยะสั้น (ช่วยแก้ปัญหาเซิร์ฟเวอร์ตรวจระยะทาง)
local FILL_COLOR = Color3.fromRGB(255, 0, 0)
local OUTLINE_COLOR = Color3.fromRGB(255, 255, 255)

-- เช็คว่าเป็นตัวละครของผู้เล่นอื่นหรือไม่
local function isAnyPlayerCharacter(object)
    local model = object:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then
        return true
    end
    return false
end

-- เช็คว่าเป็น NPC หรือร้านค้าหรือไม่
local function isNPCorShop(object)
    local model = object:FindFirstAncestorOfClass("Model")
    if model then
        if model:FindFirstChildOfClass("Humanoid") then
            return true
        end
        local lowerName = model.Name:lower()
        if lowerName:find("npc") or lowerName:find("shop") or lowerName:find("merchant") or lowerName:find("vendor") or lowerName:find("seller") then
            return true
        end
    end
    return false
end

-- ตรวจสอบไอเทมเป้าหมาย
local function isTargetItem(object)
    if not object or not object.Parent then return false end
    if isAnyPlayerCharacter(object) then return false end
    if isNPCorShop(object) then return false end
    
    if object:IsA("ProximityPrompt") then
        local action = (object.ActionText .. " " .. object.ObjectText):lower()
        if action:find("buy") or action:find("talk") or action:find("shop") or action:find("purchase") then
            return false
        end
        return true
    end

    if object:IsA("Tool") or object:IsA("TouchTransmitter") then
        return true
    end
    
    return false
end

-- แสดงผล ESP
local function applyESP(object)
    if not ESPEnabled then return end
    local target = object:IsA("Tool") and object or object.Parent
    if target and target:IsA("PVInstance") and not target:FindFirstChild(HIGHLIGHT_NAME) then
        local highlight = Instance.new("Highlight")
        highlight.Name = HIGHLIGHT_NAME
        highlight.FillColor = FILL_COLOR
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = OUTLINE_COLOR
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = target
    end
end

local function toggleESP(state)
    ESPEnabled = state
    if not state then
        cleanHighlights()
    end
end

-- ระบบเก็บไอเทมแบบทำงานขนาน (ไม่ค้างลูป)
local function collectItem(desc)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    task.spawn(function()
        if desc:IsA("TouchTransmitter") and desc.Parent then
            local targetPart = desc.Parent
            
            -- วิธีที่ 1: ใช้ firetouchinterest
            if firetouchinterest then
                firetouchinterest(root, targetPart, 0)
                firetouchinterest(root, targetPart, 1)
            end
            
            -- วิธีที่ 2: ถ้าเซิร์ฟเวอร์เช็คระยะทาง ใช้ Magnet วาร์ปไปแตะ 0.02 วิ
            if UseMagnetMode and targetPart:IsA("BasePart") then
                local oldCFrame = root.CFrame
                root.CFrame = targetPart.CFrame
                task.wait(0.02)
                root.CFrame = oldCFrame
            end

        elseif desc:IsA("ProximityPrompt") then
            if fireproximityprompt then
                fireproximityprompt(desc)
            end

        elseif desc:IsA("Tool") and desc:FindFirstChild("Handle") then
            local handle = desc.Handle
            local transmitter = handle:FindFirstChildOfClass("TouchTransmitter")
            
            if firetouchinterest and transmitter then
                firetouchinterest(root, handle, 0)
                firetouchinterest(root, handle, 1)
            end
            
            if UseMagnetMode then
                local oldCFrame = root.CFrame
                root.CFrame = handle.CFrame
                task.wait(0.02)
                root.CFrame = oldCFrame
            end
        end
    end)
end

