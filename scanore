-- =========================================================
-- [ CONFIG & LOGIC ]
-- =========================================================
local ESPEnabled = false
local FILL_COLOR = Color3.fromRGB(255, 50, 50)
local OUTLINE_COLOR = Color3.fromRGB(255, 255, 255)

-- ตรวจสอบว่าเป็น Character ของผู้เล่น
local function isAnyPlayerCharacter(object)
    local model = object:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then
        return true
    end
    return false
end

-- ตรวจสอบว่าเป็น NPC หรือร้านค้า
local function isNPCorShop(object)
    local model = object:FindFirstAncestorOfClass("Model")
    if model then
        if model:FindFirstChildOfClass("Humanoid") then
            return true
        end
        local lowerName = model.Name:lower()
        if lowerName:find("npc") or lowerName:find("shop") or lowerName:find("merchant") or lowerName:find("vendor") or lowerName:find("seller") then
            return true
        end
    end
    return false
end

-- ตรวจสอบวัตถุเป้าหมายแบบกว้าง (ESP Wide Filter)
local function isTargetItem(object)
    if not object or not object.Parent then return false end
    if isAnyPlayerCharacter(object) then return false end
    if isNPCorShop(object) then return false end
    
    -- ตรวจจับ ProximityPrompt (ยกเว้นร้านค้า)
    if object:IsA("ProximityPrompt") then
        local action = (object.ActionText .. " " .. object.ObjectText):lower()
        if action:find("buy") or action:find("talk") or action:find("shop") or action:find("purchase") then
            return false
        end
        return true
    end

    -- ตรวจจับ Tool
    if object:IsA("Tool") then
        return true
    end

    -- ตรวจจับ BasePart / MeshPart / Ores / Dropped Items
    if object:IsA("BasePart") then
        if object:FindFirstChildOfClass("TouchTransmitter") then
            return true
        end
        local pName = object.Name:lower()
        local parentName = object.Parent and object.Parent.Name:lower() or ""
        if pName:find("ore") or pName:find("gem") or pName:find("mineral") or pName:find("item") or pName:find("drop")
           or parentName:find("ore") or parentName:find("drop") or parentName:find("item") or parentName:find("mineral") then
            return true
        end
    end
    
    return false
end

-- แสดงผล ESP (Highlight + Billboard Label)
local function applyESP(object)
    if not ESPEnabled then return end
    local target = object:IsA("Tool") and object or (object:IsA("BasePart") and object or object.Parent)
    if not target or not target:IsA("PVInstance") then return end

    -- 1. สร้าง Highlight
    if not target:FindFirstChild(HIGHLIGHT_NAME) then
        local highlight = Instance.new("Highlight")
        highlight.Name = HIGHLIGHT_NAME
        highlight.FillColor = FILL_COLOR
        highlight.FillTransparency = 0.4
        highlight.OutlineColor = OUTLINE_COLOR
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = target
    end

    -- 2. สร้าง BillboardGui แสดงชื่อและระยะทาง
    local primaryPart = target:IsA("Model") and (target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)) or (target:IsA("BasePart") and target or nil)
    if primaryPart and not primaryPart:FindFirstChild(BILLBOARD_NAME) then
        local bgui = Instance.new("BillboardGui")
        bgui.Name = BILLBOARD_NAME
        bgui.AlwaysOnTop = true
        bgui.Size = UDim2.new(0, 160, 0, 30)
        bgui.StudsOffset = Vector3.new(0, 2, 0)
        bgui.Parent = primaryPart

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = target.Name
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.TextSize = 12
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.Parent = bgui
    end
end

-- อัปเดตระยะทางของ ESP
local function updateESPDistances()
    if not ESPEnabled then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == BILLBOARD_NAME and desc:IsA("BillboardGui") then
            local parentPart = desc.Parent
            if parentPart and parentPart:IsA("BasePart") then
                local dist = math.floor((root.Position - parentPart.Position).Magnitude)
                local label = desc:FindFirstChildOfClass("TextLabel")
                if label then
                    local targetName = parentPart.Parent:IsA("Model") and parentPart.Parent.Name or parentPart.Name
                    label.Text = string.format("%s [%dm]", targetName, dist)
                end
            end
        end
    end
end

local function toggleESP(state)
    ESPEnabled = state
    if not state then
        cleanESP()
    end
end

-- =========================================================
-- [ MAIN SCAN LOOP ]
-- =========================================================
task.spawn(function()
    while true do
        task.wait(0.3)
        if ESPEnabled then
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if isTargetItem(desc) then
                    applyESP(desc)
                end
            end
            updateESPDistances()
        end
    end
end)

