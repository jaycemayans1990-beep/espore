-- [ CONFIG & LOGIC ]
-- =========================================================
local ESPEnabled = false
local MAX_PULL_DISTANCE = 60 -- ระยะดูดสูงสุด (บล็อก) เพื่อป้องกันเซิร์ฟเวอร์ดึงตัวละครวาป
local FILL_COLOR = Color3.fromRGB(255, 0, 0)
local OUTLINE_COLOR = Color3.fromRGB(255, 255, 255)

-- ตรวจสอบว่าวัตถุอยู่ในตัวผู้เล่นคนใดคนหนึ่ง หรืออยู่ใน Backpack หรือไม่
local function isInsideAnyCharacterOrBackpack(object)
    if not object then return true end
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and object:IsDescendantOf(player.Character) then
            return true
        end
        if player:FindFirstChild("Backpack") and object:IsDescendantOf(player.Backpack) then
            return true
        end
    end
    return false
end

-- ตรวจสอบว่าเป็น NPC หรือร้านค้า
local function isNPCorShop(object)
    local model = object:FindFirstAncestorOfClass("Model")
    if model then
        if model:FindFirstChildOfClass("Humanoid") then
            return true
        end
        local lowerName = model.Name:lower()
        if lowerName:find("npc") or lowerName:find("shop") or lowerName:find("merchant") or lowerName:find("vendor") or lowerName:find("seller") then
            return true
        end
    end
    return false
end

-- ตรวจสอบว่าเป็นไอเทมเป้าหมายที่อยู่บนพื้น
local function isTargetItem(object)
    if not object or not object.Parent then return false end
    if isInsideAnyCharacterOrBackpack(object) then return false end
    if isNPCorShop(object) then return false end
    
    if object:IsA("ProximityPrompt") then
        local action = (object.ActionText .. " " .. object.ObjectText):lower()
        if action:find("buy") or action:find("talk") or action:find("shop") or action:find("purchase") then
            return false
        end
        return true
    end

    if object:IsA("Tool") then
        return true
    end

    if object:IsA("BasePart") then
        if object.Anchored then return false end
        if object.Size.Magnitude > 15 then return false end
        if object:FindFirstChildOfClass("TouchTransmitter") or object:IsA("MeshPart") then
            return true
        end
    end
    
    return false
end

local function applyESP(object)
    if not ESPEnabled then return end
    local target = object:IsA("Tool") and object or (object:IsA("BasePart") and object or object.Parent)
    if target and target:IsA("PVInstance") and not target:FindFirstChild(HIGHLIGHT_NAME) then
        local highlight = Instance.new("Highlight")
        highlight.Name = HIGHLIGHT_NAME
        highlight.FillColor = FILL_COLOR
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = OUTLINE_COLOR
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = target
    end
end

local function toggleESP(state)
    ESPEnabled = state
    if not state then
        cleanHighlights()
    end
end

-- ตารางเก็บ Cooldown ไอเทมที่เพิ่งดึงไป
local pulledCache = {}

-- ฟังก์ชันดึงไอเทมเข้าหาตัวละครแบบปลอดภัยสูงสุด
local function pullItemToPlayer(desc)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local targetPart = nil
    
    if desc:IsA("Tool") then
        targetPart = desc:FindFirstChild("Handle") or desc:FindFirstChildWhichIsA("BasePart", true)
    elseif desc:IsA("BasePart") and not desc.Anchored then
        targetPart = desc
    elseif desc:IsA("TouchTransmitter") and desc.Parent and desc.Parent:IsA("BasePart") and not desc.Parent.Anchored then
        targetPart = desc.Parent
    end

    if targetPart and targetPart:IsA("BasePart") and not targetPart.Anchored then
        -- 1. เช็คระยะห่าง ป้องกันเซิร์ฟเวอร์ดึงตัวละครวาป
        local dist = (root.Position - targetPart.Position).Magnitude
        if dist > MAX_PULL_DISTANCE then return end

        -- 2. เช็ค Cooldown ป้องกันการดึงไอเทมชิ้นเดิมซ้ำๆ
        local now = tick()
        if pulledCache[targetPart] and (now - pulledCache[targetPart]) < 1.5 then
            return
        end
        pulledCache[targetPart] = now

        -- 3. ทำลาย Weld / Constraint ที่ยึดไอเทมไว้ก่อนย้าย CFrame
        for _, child in ipairs(targetPart:GetChildren()) do
            if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") or child:IsA("Snap") then
                child:Destroy()
            end
        end

        -- 4. ย้าย CFrame มาไว้ตรงหน้าตัวละคร
        targetPart.CanCollide = false
        targetPart.AssemblyLinearVelocity = Vector3.zero
        targetPart.AssemblyAngularVelocity = Vector3.zero
        targetPart.CFrame = root.CFrame * CFrame.new(0, 0, -2.5)

    elseif desc:IsA("ProximityPrompt") then
        local parentPart = desc.Parent:IsA("BasePart") and desc.Parent or desc.Parent:FindFirstChildWhichIsA("BasePart", true)
        if parentPart then
            local dist = (root.Position - parentPart.Position).Magnitude
            if dist <= MAX_PULL_DISTANCE and fireproximityprompt then
                fireproximityprompt(desc)
            end
        end
    end
end

-- =========================================================
-- [ MAIN SCAN LOOP ]
-- =========================================================
task.spawn(function()
    while true do
        task.wait(0.2)
        local itemCount = 0
        if ESPEnabled or _G.SnyX_AutoCollect then
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if isTargetItem(desc) then
                    itemCount = itemCount + 1
                    if ESPEnabled then
                        applyESP(desc)
                    end
                    if _G.SnyX_AutoCollect then
                        pullItemToPlayer(desc)
                    end
                end
            end
        end
        
        if _G.SnyX_AutoCollect then
            CollectButton.Text = "PULLING... (" .. tostring(itemCount) .. ")"
        end
    end
end)

