local HIGHLIGHT_NAME = "SnyX_ItemHighlight"
local function cleanHighlights()
    for _, desc in ipairs(Workspace:GetChildren()) do
        local hl = desc:FindFirstChild(HIGHLIGHT_NAME)
        if hl then hl:Destroy() end
    end
end
cleanHighlights()

-- =========================================================
-- [ CONFIG & LOGIC ]
-- =========================================================
local ESPEnabled = false
local FILL_COLOR = Color3.fromRGB(255, 0, 0)
local OUTLINE_COLOR = Color3.fromRGB(255, 255, 255)

-- ตรวจสอบเฉพาะไอเทมจริง ไม่สแกนพร่ำเพรื่อ
local function checkAndApply(object)
    if not ESPEnabled then return end
    if object:IsA("Tool") or object:FindFirstChildOfClass("TouchTransmitter") then
        if not object:FindFirstChild(HIGHLIGHT_NAME) then
            local highlight = Instance.new("Highlight")
            highlight.Name = HIGHLIGHT_NAME
            highlight.FillColor = FILL_COLOR
            highlight.FillTransparency = 0.5
            highlight.OutlineColor = OUTLINE_COLOR
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = object
        end
    end
end

-- สแกนเฉพาะลูกชั้นแรก (ช่วยประหยัดแรมมือถือได้มหาศาล)
local function toggleESP(state)
    ESPEnabled = state
    if state then
        for _, child in ipairs(Workspace:GetChildren()) do
            checkAndApply(child)
        end
        -- ใช้ ChildAdded แทน DescendantAdded เพื่อป้องกัน RAM เครื่องระเบิด
        _G.SnyX_Connection = Workspace.ChildAdded:Connect(checkAndApply)
    else
        if _G.SnyX_Connection then
            _G.SnyX_Connection:Disconnect()
            _G.SnyX_Connection = nil
        end
        cleanHighlights()
    end
end

-- Auto Collect Engine แบบมี Limit Rate ป้องกันเซิร์ฟเวอร์เตะ
local function collectItem(object)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local transmitter = object:FindFirstChildOfClass("TouchTransmitter") or (object:IsA("Tool") and object:FindFirstChild("Handle") and object.Handle:FindFirstChildOfClass("TouchTransmitter"))
    if transmitter then
        local targetPart = transmitter.Parent
        if firetouchinterest then
            firetouchinterest(root, targetPart, 0)
            task.wait(0.02)
            firetouchinterest(root, targetPart, 1)
        else
            targetPart.CFrame = root.CFrame
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do -- หน่วงเวลา 0.5 วิ ไม่ให้ CPU ค้าง
        if not _G.SnyX_AutoCollect then break end
        for _, child in ipairs(Workspace:GetChildren()) do
            if child:FindFirstChild(HIGHLIGHT_NAME) or child:IsA("Tool") then
                collectItem(child)
            end
        end
    end
end)

