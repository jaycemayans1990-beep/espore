-- =========================================================
-- [ MAIN SCAN LOOP ]
-- =========================================================
task.spawn(function()
    while true do
        task.wait(0.3)
        local itemCount = 0
        if ESPEnabled or _G.SnyX_AutoCollect then
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if isTargetItem(desc) then
                    itemCount = itemCount + 1
                    if ESPEnabled then
                        applyESP(desc)
                    end
                    if _G.SnyX_AutoCollect then
                        collectItem(desc)
                    end
                end
            end
        end
        
        -- อัปเดตข้อความแสดงจำนวนไอเทมที่ตรวจพบ
        if _G.SnyX_AutoCollect then
            CollectButton.Text = "COLLECTING... (" .. tostring(itemCount) .. ")"
        end
    end
end)

