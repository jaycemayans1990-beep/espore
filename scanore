-- [ CONFIG & LOGIC ]
-- =========================================================
local ESPEnabled = false
local FILL_COLOR = Color3.fromRGB(255, 215, 0) -- สีทองสำหรับของหายาก/ราคาสูง
local OUTLINE_COLOR = Color3.fromRGB(255, 255, 255)

-- คีย์เวิร์ดระบุของหายากและราคาสูง (Rare & High Value Keywords)
local RARE_KEYWORDS = {
    "legendary", "mythic", "exotic", "secret", "divine", "celestial", "godly",
    "diamond", "ruby", "emerald", "sapphire", "crystal", "void", "cosmic",
    "ancient", "huge", "titanium", "gold", "plat", "obsidian", "rainbow",
    "rare", "epic", "relic", "artifact", "chest", "gem"
}

-- คีย์เวิร์ดของทั่วไปที่ต้องการตัดออก (Common / Trash Keywords)
local COMMON_KEYWORDS = {
    "dirt", "stone", "rock", "coal", "copper", "iron", "sand", "gravel", "wood", "common"
}

-- ตรวจสอบว่าเป็น Character ของผู้เล่น
local function isAnyPlayerCharacter(object)
    local model = object:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then
        return true
    end
    return false
end

-- ตรวจสอบว่าเป็น NPC หรือร้านค้า
local function isNPCorShop(object)
    local model = object:FindFirstAncestorOfClass("Model")
    if model then
        if model:FindFirstChildOfClass("Humanoid") then
            return true
        end
        local lowerName = model.Name:lower()
        if lowerName:find("npc") or lowerName:find("shop") or lowerName:find("merchant") or lowerName:find("vendor") or lowerName:find("seller") then
            return true
        end
    end
    return false
end

-- ตรวจสอบว่าเป็นของราคาสูง/หายาก เท่านั้น
local function isHighValueItem(object)
    if not object or not object.Parent then return false end
    if isAnyPlayerCharacter(object) then return false end
    if isNPCorShop(object) then return false end

    local name = object.Name:lower()
    local parentName = object.Parent and object.Parent.Name:lower() or ""
    local fullName = name .. " " .. parentName

    -- ข้ามของระดับธรรมดา/ขยะ
    for _, common in ipairs(COMMON_KEYWORDS) do
        if name == common or parentName == common then
            return false
        end
    end

    -- 1. ตรวจสอบจาก Attribute / Value ในตัววัตถุ (ถ้ามี)
    local rarityAttr = object:GetAttribute("Rarity") or object:GetAttribute("Value") or object:GetAttribute("Tier")
    if rarityAttr then
        local rStr = tostring(rarityAttr):lower()
        if rStr:find("legend") or rStr:find("myth") or rStr:find("exic") or rStr:find("rare") or rStr:find("secret") then
            return true
        end
    end

    local valueObj = object:FindFirstChild("Value") or object:FindFirstChild("Rarity") or object:FindFirstChild("Price")
    if valueObj and (valueObj:IsA("IntValue") or valueObj:IsA("NumberValue")) and valueObj.Value > 500 then
        return true
    end

    -- 2. ตรวจสอบชื่อวัตถุตรงกับคีย์เวิร์ดของหายาก
    for _, kw in ipairs(RARE_KEYWORDS) do
        if fullName:find(kw) then
            return true
        end
    end

    -- 3. ตรวจสอบ ProximityPrompt ที่เป็นของหายาก
    if object:IsA("ProximityPrompt") then
        local action = (object.ActionText .. " " .. object.ObjectText):lower()
        for _, kw in ipairs(RARE_KEYWORDS) do
            if action:find(kw) then
                return true
            end
        end
    end

    return false
end

-- แสดงผล Highlight สำหรับของหายากเท่านั้น
local function applyESP(object)
    if not ESPEnabled then return end
    local target = object:IsA("Tool") and object or (object:IsA("BasePart") and object or object.Parent)
    if not target or not target:IsA("PVInstance") then return end

    if not target:FindFirstChild(HIGHLIGHT_NAME) then
        local highlight = Instance.new("Highlight")
        highlight.Name = HIGHLIGHT_NAME
        highlight.FillColor = FILL_COLOR
        highlight.FillTransparency = 0.3
        highlight.OutlineColor = OUTLINE_COLOR
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = target
    end
end

local function toggleESP(state)
    ESPEnabled = state
    if not state then
        cleanESP()
    end
end

-- =========================================================
-- [ MAIN SCAN LOOP ]
-- =========================================================
task.spawn(function()
    while true do
        task.wait(0.4)
        if ESPEnabled then
            for _, desc in ipairs(Workspace:GetDescendants()) do
                if isHighValueItem(desc) then
                    applyESP(desc)
                end
            end
        end
    end
end)

